{% extends "base.html" %}

{% block title %}Transactions — NEXUS{% endblock %}

{% block content %}
<div class="page transactions-page">

  <header class="topbar transactions-topbar">
    <div class="topbar-copy">
      <div class="eyebrow">LEDGER</div>

      <h1>Transactions</h1>

      <p class="muted">
        Record, manage, and review your personal financial activity.
      </p>
    </div>
  </header>


  <!-- ==========================================================
       ADD TRANSACTION
       ========================================================== -->

  <section class="glass-card transaction-entry-card">

    <div class="transaction-entry-header">

      <div>
        <div class="eyebrow">QUICK ENTRY</div>

        <h2>
          Add Transaction
        </h2>

        <p class="muted">
          Record income or expenses directly into your NEXUS ledger.
        </p>
      </div>

    </div>


    <form
      method="post"
      action="{{ url_for('main.add_transaction') }}"
      class="transaction-entry-form"
    >

      <!-- TRANSACTION TYPE -->

      <div class="transaction-type-selector">

        <label class="transaction-type-option expense-option">

          <input
            type="radio"
            name="kind"
            value="expense"
            checked
            onchange="NexusTransactionType.update()"
          >

          <span>
            EXPENSE
          </span>

        </label>


        <label class="transaction-type-option income-option">

          <input
            type="radio"
            name="kind"
            value="income"
            onchange="NexusTransactionType.update()"
          >

          <span>
            INCOME
          </span>

        </label>

      </div>


      <!-- AMOUNT -->

      <div class="transaction-form-grid">

        <div class="transaction-field amount-field">

          <label for="transactionAmount">
            Amount
          </label>

          <div class="amount-wrapper">
            <span>₹</span>

            <input
              id="transactionAmount"
              name="amount"
              type="number"
              min="0.01"
              step="0.01"
              placeholder="0.00"
              required
            >
          </div>

        </div>


        <!-- CATEGORY -->

        <div class="transaction-field">

          <label for="transactionCategory">
            Category
          </label>

          <select
            id="transactionCategory"
            name="category"
            required
          >

            <option value="Food">Food</option>
            <option value="Transport">Transport</option>
            <option value="Bills">Bills</option>
            <option value="Shopping">Shopping</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Health">Health</option>
            <option value="Education">Education</option>
            <option value="Travel">Travel</option>
            <option value="Other">Other</option>

          </select>

        </div>


        <!-- PAYMENT METHOD -->

        <div class="transaction-field">

          <label for="transactionPayment">
            Payment Method
          </label>

          <select
            id="transactionPayment"
            name="payment_method"
            required
          >

            {% for payment in payments %}
              <option value="{{ payment }}">
                {{ payment }}
              </option>
            {% endfor %}

          </select>

        </div>


        <!-- DATE -->

        <div class="transaction-field">

          <label for="transactionDate">
            Date
          </label>

          <input
            id="transactionDate"
            name="transaction_date"
            type="date"
            value="{{ today }}"
            required
          >

        </div>

      </div>


      <!-- NOTE -->

      <div class="transaction-field">

        <label for="transactionNote">
          Note
        </label>

        <input
          id="transactionNote"
          name="note"
          type="text"
          maxlength="500"
          placeholder="Optional note..."
        >

      </div>


      <!-- ACTION -->

      <div class="transaction-entry-actions">

        <button
          type="submit"
          class="primary-btn"
          id="transactionSubmitButton"
        >
          <span>Record Expense</span>
          <b>↗</b>
        </button>

      </div>

    </form>

  </section>


  <!-- ==========================================================
       TRANSACTION SUMMARY STRIP
       ========================================================== -->

  <div class="ledger-toolbar">

    <div class="ledger-toolbar-copy">

      <strong>
        Transaction ledger
      </strong>

      <span>
        Every recorded income and expense in one place.
      </span>

    </div>

  </div>


  <!-- ==========================================================
       TRANSACTION TABLE
       ========================================================== -->

  <div class="glass-card table-card transactions-table-card">

    <div class="table-scroll">

      <table class="transactions-table">

        <thead>

          <tr>

            <th scope="col">
              DATE
            </th>

            <th scope="col">
              TYPE
            </th>

            <th scope="col">
              CATEGORY
            </th>

            <th scope="col">
              METHOD
            </th>

            <th scope="col">
              NOTE
            </th>

            <th
              scope="col"
              class="amount-column"
            >
              AMOUNT
            </th>

            <th
              scope="col"
              class="action-column"
            >
              <span class="sr-only">
                Actions
              </span>
            </th>

          </tr>

        </thead>


        <tbody>

          {% for t in rows %}

            <tr>

              <td>
                <span class="transaction-date">
                  {{ t.transaction_date }}
                </span>
              </td>


              <td>
                <span class="pill {{ t.kind }}">
                  {{ t.kind }}
                </span>
              </td>


              <td>
                <div class="transaction-category">
                  {{ t.category }}
                </div>
              </td>


              <td>
                <span class="transaction-method">
                  {{ t.payment_method }}
                </span>
              </td>


              <td>
                <span class="transaction-note">
                  {{ t.note or "—" }}
                </span>
              </td>


              <td class="money {{ t.kind }}">

                {{ "+" if t.kind=="income" else "−" }}₹{{ "%.2f"|format(t.amount) }}

              </td>


              <td class="transaction-actions">

                <form
                  method="post"
                  action="{{ url_for('main.delete_transaction', tx_id=t.id) }}"
                  onsubmit="return confirm('Delete this transaction?')"
                >

                  <button
                    type="submit"
                    class="icon-btn"
                    title="Delete transaction"
                    aria-label="Delete transaction"
                  >
                    ×
                  </button>

                </form>

              </td>

            </tr>


          {% else %}

            <tr>

              <td
                colspan="7"
                class="empty transaction-empty"
              >

                <div class="empty-state">

                  <div
                    class="empty-state-icon"
                    aria-hidden="true"
                  >
                    +
                  </div>

                  <strong>
                    No transactions recorded
                  </strong>

                  <span>
                    Your income and expenses will appear here once
                    you record your first transaction.
                  </span>

                </div>

              </td>

            </tr>

          {% endfor %}

        </tbody>

      </table>

    </div>

  </div>

</div>


<!-- ==========================================================
     TRANSACTION TYPE LOGIC
     ========================================================== -->

<script>
window.NexusTransactionType = {

  update() {

    const selected = document.querySelector(
      'input[name="kind"]:checked'
    );

    const category = document.getElementById(
      "transactionCategory"
    );

    const submit = document.getElementById(
      "transactionSubmitButton"
    );

    if (!selected || !category || !submit) {
      return;
    }

    const isIncome = selected.value === "income";


    if (isIncome) {

      category.innerHTML = `
        <option value="Other">Other</option>
      `;

      submit.innerHTML = `
        <span>Record Income</span>
        <b>↗</b>
      `;

    } else {

      category.innerHTML = `
        <option value="Food">Food</option>
        <option value="Transport">Transport</option>
        <option value="Bills">Bills</option>
        <option value="Shopping">Shopping</option>
        <option value="Entertainment">Entertainment</option>
        <option value="Health">Health</option>
        <option value="Education">Education</option>
        <option value="Travel">Travel</option>
        <option value="Other">Other</option>
      `;

      submit.innerHTML = `
        <span>Record Expense</span>
        <b>↗</b>
      `;

    }

  }

};

document.addEventListener(
  "DOMContentLoaded",
  () => window.NexusTransactionType.update()
);
</script>

{% endblock %}