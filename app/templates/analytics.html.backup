{% extends "base.html" %}
 
{% block title %}Analytics — NEXUS{% endblock %}
 
{% block content %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap');
/* ===== NEXUS dashboard design system: 8px grid, fixed type scale ===== */
:root{--g:#0e7c66;--gd:#0d3b33;--gl:#d7efe6;--ink:#13203a;--mu:#5d6a80;--ln:#dfe4dc;--am:#f2a93b;--rd:#d24f69;--r:20px;--gap:24px;--pad:28px}
body{background:#f4f6f1}
[hidden]{display:none!important}
.page.analytics-page{font:400 15px/1.55 Manrope,system-ui,sans-serif;color:var(--ink);font-variant-numeric:tabular-nums;max-width:1320px;margin:0 auto;padding:40px 48px 88px}
.analytics-page::before,.analytics-page::after,.analytics-page .dashboard-grid::after,
.analytics-page .glass-card::before,.analytics-page .glass-card::after,
.analytics-page .stat-card::before,.analytics-page .stat-card::after,
.analytics-page .primary-btn::before,.analytics-page .primary-btn::after,
.analytics-page .outline-btn::before,.analytics-page .card-glow{display:none}
.analytics-page h1,.analytics-page h2,.analytics-page h3{font-family:'Instrument Serif',serif;font-weight:400;letter-spacing:-.01em;color:var(--ink)}
.analytics-page small,.analytics-page .eyebrow{font:700 12px/1.2 Manrope;letter-spacing:.08em;color:var(--mu)}
.analytics-page .eyebrow::before{background:var(--g);box-shadow:none;animation:none}
.analytics-page .muted{font:400 16px/1.6 Manrope;color:var(--mu)}
 
/* header */
.analytics-page .topbar{margin-bottom:40px;align-items:center}
.analytics-page .topbar::after{background:var(--ln)}
.analytics-page .topbar h1{font-size:clamp(2.25rem,4vw,3.25rem);line-height:1.05;margin:12px 0 8px;background:none;-webkit-text-fill-color:var(--ink)}
.analytics-page .system-status{background:var(--gl);border:0;color:var(--g);font:800 12px Manrope;letter-spacing:.08em;box-shadow:none;padding:10px 16px}
.analytics-page .pulse{background:var(--g);box-shadow:0 0 0 4px rgba(14,124,102,.18)}
 
/* cards */
.analytics-page .glass-card,.analytics-page .stat-card{background:#fff;border:1px solid var(--ln);border-radius:var(--r);box-shadow:none;backdrop-filter:none;padding:var(--pad)}
.analytics-page .glass-card:hover,.analytics-page .stat-card:hover{box-shadow:0 24px 50px -30px rgba(19,32,58,.35);border-color:#cfd7cb;transform:none}
.analytics-page .card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:24px}
.analytics-page .card-head h2{font-size:28px;line-height:1.1;margin:8px 0 0}
.analytics-page .card-head a,.analytics-page .card-link{color:var(--g);font:700 14px/1 Manrope;border-bottom:2px solid var(--gl);padding-bottom:4px;white-space:nowrap}
.analytics-page .card-head a::after{display:none}
 
/* grids */
.analytics-page .stat-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--gap);margin-bottom:var(--gap)}
.analytics-page .dashboard-grid{grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:var(--gap);margin-bottom:var(--gap);align-items:stretch}
 
/* stat cards */
.analytics-page .stat-card{display:flex;flex-direction:column;min-height:176px;position:relative;overflow:hidden}
.analytics-page .stat-card strong{font:800 30px/1.1 Manrope;letter-spacing:-.02em;color:var(--ink);margin:14px 0 0}
.analytics-page .stat-card span{margin-top:auto;padding-top:16px;font:500 13px/1.4 Manrope;color:var(--mu)}
.analytics-page .stat-card.accent{background:var(--gd);border-color:var(--gd)}
.analytics-page .stat-card.accent small,.analytics-page .stat-card.accent span{color:#9fd6c6}
.analytics-page .stat-card.accent strong{color:#fff}
.analytics-page .rate{position:absolute;left:0;right:0;bottom:0;height:6px;background:rgba(255,255,255,.14)}
.analytics-page .rate u{display:block;height:100%;background:var(--am);text-decoration:none}
.analytics-page .stat-card.forecast{background:var(--gl);border-color:var(--gl)}
.analytics-page .forecast strong{color:var(--g);text-shadow:none}
.analytics-page .positive{color:var(--g)!important}
.analytics-page .negative{color:var(--rd)!important}
 
/* chart card */
.analytics-page .chart-card,.analytics-page .quick-card,.analytics-page .insight-card,.analytics-page .communication-card{display:flex;flex-direction:column}
.analytics-page .chart-box{height:240px;padding:0;background:none}
.analytics-page .chart-box::before,.analytics-page .chart-box::after{display:none}
.cats{list-style:none;margin:24px 0 0;padding:20px 0 0;border-top:1px solid var(--ln);display:grid;gap:14px}
.cats li{display:grid;grid-template-columns:1fr auto;gap:6px 12px;font:600 14px/1.2 Manrope}
.cats i{grid-column:1/-1;height:8px;border-radius:9px;background:#eef1ea;overflow:hidden}
.cats u{display:block;height:100%;background:var(--g);border-radius:9px}
 
/* forms */
.analytics-page .quick-form,.analytics-page .communication-form{display:flex;flex-direction:column;gap:16px;flex:1}
.analytics-page .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.analytics-page input,.analytics-page select,.analytics-page textarea{background:#fff;border:1.5px solid var(--ln);border-radius:12px;color:var(--ink);font:500 15px/1.4 Manrope;padding:0 16px;height:48px;box-shadow:none}
.analytics-page textarea{height:auto;min-height:168px;padding:14px 16px;resize:vertical;flex:1}
.analytics-page input:focus,.analytics-page select:focus,.analytics-page textarea:focus{border-color:var(--g);box-shadow:0 0 0 4px var(--gl);transform:none}
.analytics-page .amount-input{font:400 38px 'Instrument Serif';height:76px;padding:0 20px;background:#f4f6f1;border-color:transparent}
.analytics-page .segmented{background:#eef1ea;border:0;border-radius:99px;padding:4px;height:48px}
.analytics-page .segmented span{border-radius:99px;font:700 14px/40px Manrope;color:var(--mu);padding:0}
.analytics-page .segmented input:checked+span{background:var(--ink);color:#fff;box-shadow:none}
.analytics-page .segmented input:checked+span::after{display:none}
.analytics-page .primary-btn,.analytics-page .outline-btn{min-height:48px;padding:0 24px;border-radius:99px;font:700 15px Manrope;box-shadow:none}
.analytics-page .primary-btn{background:var(--g);border:0;color:#fff;margin-top:auto}
.analytics-page .primary-btn:hover{background:#0b6654;transform:translateY(-2px);box-shadow:0 12px 24px -10px rgba(14,124,102,.6)}
.analytics-page .outline-btn{background:#fff;border:1.5px solid var(--ink);color:var(--ink)}
.analytics-page .outline-btn:hover{background:var(--ink);color:#fff}
 
@media(max-width:1180px){.analytics-page .stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:980px){.analytics-page .dashboard-grid,.communication-grid{grid-template-columns:1fr}.page.analytics-page{padding:32px 28px 72px}}
@media(max-width:650px){.page.analytics-page{padding:24px 16px 64px}.analytics-page .stat-grid,.analytics-page .form-row{grid-template-columns:1fr}.analytics-page .glass-card,.analytics-page .stat-card{padding:22px}.analytics-page .card-head h2,.communication-card-head h3{font-size:24px}}
 
/* ===== analytics specific ===== */
.analytics-page .stat-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
.analytics-page .analytics-main-grid{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr)}
.analytics-page .card-head .muted{font:400 14px/1.5 Manrope;margin:8px 0 0}
.analytics-page .chart-box.tall{height:380px}
.analytics-page .chart-card,.analytics-page .analytics-category-card{display:flex;flex-direction:column}
.analytics-page .rank-list{display:grid;gap:24px}
.analytics-page .rank{display:grid;grid-template-columns:36px minmax(0,1fr);gap:16px;align-items:center}
.analytics-page .rank-number{width:36px;height:36px;border-radius:50%;background:var(--gl);color:var(--g);display:grid;place-items:center;font:800 14px Manrope}
.analytics-page .rank-heading{display:flex;justify-content:space-between;gap:12px;align-items:baseline}
.analytics-page .rank-heading strong{font:700 15px/1.3 Manrope}
.analytics-page .rank-heading span{font:600 14px Manrope;color:var(--mu)}
.analytics-page .rank-progress{display:block;height:8px;border-radius:9px;background:#eef1ea;margin-top:10px;overflow:hidden}
.analytics-page .rank-progress b{display:block;height:100%;border-radius:9px;background:var(--g);box-shadow:none}
.analytics-page .empty{display:grid;gap:6px;text-align:center;padding:48px 8px}
.analytics-page .empty strong{font:700 15px Manrope;color:var(--ink)}
.analytics-page .empty span{font:400 14px/1.5 Manrope;color:var(--mu)}
.analytics-page .analytics-note{display:flex;gap:20px;align-items:flex-start;background:var(--gl);border-radius:var(--r);padding:var(--pad)}
.analytics-page .analytics-note-icon{flex:0 0 48px;width:48px;height:48px;border-radius:50%;background:var(--g);color:#fff;display:grid;place-items:center;font-size:20px}
.analytics-page .analytics-note strong{font:400 26px/1.1 'Instrument Serif'}
.analytics-page .analytics-note p{font:400 15px/1.6 Manrope;color:var(--mu);margin-top:8px;max-width:760px}
@media(max-width:980px){.analytics-page .analytics-main-grid{grid-template-columns:1fr}}
@media(max-width:820px){.analytics-page .stat-grid{grid-template-columns:1fr}}
@media(max-width:650px){.analytics-page .chart-box.tall{height:300px}.analytics-page .analytics-note{flex-direction:column}}
</style>
 
<div class="page analytics-page">
 
  <header class="topbar analytics-topbar">
    <div class="topbar-copy">
      <div class="eyebrow">INTELLIGENCE LAYER</div>
      <h1>Analytics &amp; Forecasting</h1>
      <p class="muted">Understand your financial patterns and see where your money is going.</p>
    </div>
  </header>
 
  <section class="stat-grid analytics-stat-grid" aria-label="Analytics overview">
    <div class="stat-card forecast">
      <small>NEXT-MONTH FORECAST</small>
      <strong data-counter="{{ '%.2f'|format(forecast.value|float(0)) }}" data-prefix="₹" data-decimals="2">₹{{ "%.2f"|format(forecast.value|float(0)) }}</strong>
      <span>{{ forecast.method }}</span>
    </div>
    <div class="stat-card accent">
      <small>MONTHS ANALYZED</small>
      <strong>{{ forecast.months_used|default(0) }}</strong>
      <span>Personal transaction history</span>
    </div>
    <div class="stat-card">
      <small>MODEL STATUS</small>
      <strong>{{ forecast.confidence }}</strong>
      <span>Based only on your data</span>
    </div>
  </section>
 
  <section class="dashboard-grid analytics-main-grid">
 
    <div class="glass-card chart-card analytics-chart-card">
      <div class="card-head">
        <div>
          <small>MONTHLY TREND</small>
          <h2>Income vs expense</h2>
          <p class="muted">Track how your financial activity changes over time.</p>
        </div>
      </div>
      <div class="chart-box tall">
        <canvas id="monthlyChart" aria-label="Monthly income and expense chart" role="img"></canvas>
      </div>
    </div>
 
    <div class="glass-card analytics-category-card">
      <div class="card-head">
        <div>
          <small>CATEGORY INTELLIGENCE</small>
          <h2>Spending mix</h2>
          <p class="muted">Your highest recorded spending categories.</p>
        </div>
      </div>
 
      {% set top = ((categories|list)[0].total|float(0)) if categories else 0 %}
      <div class="rank-list">
        {% for c in categories %}
        <div class="rank">
          <span class="rank-number">{{ loop.index }}</span>
          <div class="rank-content">
            <div class="rank-heading">
              <strong>{{ c.category }}</strong>
              <span>₹{{ "%.0f"|format(c.total|float(0)) }}</span>
            </div>
            <i class="rank-progress" aria-hidden="true">
              <b style="width:{{ ((c.total|float(0) / top * 100) | round(1)) if top > 0 else 0 }}%"></b>
            </i>
          </div>
        </div>
        {% else %}
        <div class="empty">
          <strong>No spending data yet</strong>
          <span>Record a few expenses to activate category analytics.</span>
        </div>
        {% endfor %}
      </div>
    </div>
 
  </section>
 
  <section class="analytics-note">
    <div class="analytics-note-icon">◈</div>
    <div>
      <strong>Personal intelligence</strong>
      <p>NEXUS builds its forecast from your own transaction history. As more data is recorded, the system can identify stronger patterns in your spending behaviour.</p>
    </div>
  </section>
 
</div>
{% endblock %}
 
 
{% block scripts %}
<script>
document.addEventListener("DOMContentLoaded", () => {
 
  const labels  = {{ monthly|map(attribute='month')|list|tojson }};
  const income  = {{ monthly|map(attribute='income')|map('float')|list|tojson }};
  const expense = {{ monthly|map(attribute='expense')|map('float')|list|tojson }};
 
  if (window.NexusCharts && typeof window.NexusCharts.line === "function") {
    const ch = window.NexusCharts.line("monthlyChart", labels, income, expense);
    if (ch) {
      const [inc, exp] = ch.data.datasets;
      Object.assign(inc, { borderColor: "#0e7c66", backgroundColor: "rgba(14,124,102,.10)", pointBackgroundColor: "#0e7c66", borderWidth: 3 });
      Object.assign(exp, { borderColor: "#d24f69", backgroundColor: "rgba(210,79,105,.08)", pointBackgroundColor: "#d24f69", borderWidth: 3 });
      const o = ch.options;
      o.plugins.legend.labels.color = "#5d6a80";
      o.plugins.legend.position = "top";
      o.plugins.legend.align = "end";
      ["x", "y"].forEach(a => {
        o.scales[a].ticks.color = "#5d6a80";
        o.scales[a].grid.color = "#edf0ea";
      });
      o.scales.y.ticks.callback = v => "₹" + Number(v).toLocaleString("en-IN");
      ch.update();
    }
  }
});
</script>
{% endblock %}