@main.route("/analytics")
@login_required
def analytics():

    db = get_db()
    uid = session["user_id"]

    monthly = db.execute(
        """
        SELECT
            substr(
                transaction_date,
                1,
                7
            ) AS month,

            SUM(
                CASE
                    WHEN kind='income'
                    THEN amount
                    ELSE 0
                END
            ) AS income,

            SUM(
                CASE
                    WHEN kind='expense'
                    THEN amount
                    ELSE 0
                END
            ) AS expense

        FROM transactions

        WHERE user_id=?

        GROUP BY month

        ORDER BY month
        """,
        (uid,),
    ).fetchall()

    categories = db.execute(
        """
        SELECT
            category,
            SUM(amount) AS total

        FROM transactions

        WHERE user_id=?
          AND kind='expense'

        GROUP BY category

        ORDER BY total DESC
        """,
        (uid,),
    ).fetchall()

    forecast = forecast_next_month(
        uid
    )

    return render_template(
        "analytics.html",
        monthly=monthly,
        categories=categories,
        forecast=forecast,
    )


