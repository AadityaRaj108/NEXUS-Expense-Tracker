@main.route(
    "/register",
    methods=["GET", "POST"],
)
def register():

    if "user_id" in session:
        return redirect(
            url_for("main.dashboard")
        )

    if request.method == "POST":

        name = request.form.get(
            "name",
            "",
        ).strip()

        email = request.form.get(
            "email",
            "",
        ).strip().lower()

        password = request.form.get(
            "password",
            "",
        )

        email_pattern = (
            r"^[^@\s]+@[^@\s]+\.[^@\s]+$"
        )

        if not name:
            flash(
                "Please enter your name.",
                "error",
            )
            return redirect(
                url_for("main.register")
            )

        if not re.match(
            email_pattern,
            email,
        ):
            flash(
                "Please enter a valid email address.",
                "error",
            )
            return redirect(
                url_for("main.register")
            )

        if len(password) < 6:
            flash(
                "Password must contain at least 6 characters.",
                "error",
            )
            return redirect(
                url_for("main.register")
            )

        db = get_db()

        existing = db.execute(
            """
            SELECT id
            FROM users
            WHERE email=?
            """,
            (email,),
        ).fetchone()

        if existing:
            flash(
                "That email is already registered.",
                "error",
            )
            return redirect(
                url_for("main.login")
            )

        try:

            cur = db.execute(
                """
                INSERT INTO users(
                    name,
                    email,
                    password_hash
                )
                VALUES(?,?,?)
                """,
                (
                    name,
                    email,
                    generate_password_hash(
                        password
                    ),
                ),
            )

            user_id = cur.lastrowid

            # ------------------------------------------------
            # PROFILE
            # ------------------------------------------------

            profile = db.execute(
                """
                SELECT user_id
                FROM user_profiles
                WHERE user_id=?
                """,
                (user_id,),
            ).fetchone()

            if not profile:

                parts = [
                    part
                    for part in name.split()
                    if part
                ]

                initials = "".join(
                    part[0]
                    for part in parts
                )[:2].upper()

                if not initials:
                    initials = "U"

                db.execute(
                    """
                    INSERT INTO user_profiles(
                        user_id,
                        display_name,
                        timezone,
                        currency,
                        locale,
                        avatar_initials
                    )
                    VALUES(
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?
                    )
                    """,
                    (
                        user_id,
                        name,
                        "Asia/Kolkata",
                        "INR",
                        "en-IN",
                        initials,
                    ),
                )

            # ------------------------------------------------
            # NOTIFICATION PREFERENCES
            # ------------------------------------------------

            prefs = db.execute(
                """
                SELECT user_id
                FROM notification_preferences
                WHERE user_id=?
                """,
                (user_id,),
            ).fetchone()

            if not prefs:

                db.execute(
                    """
                    INSERT INTO notification_preferences(
                        user_id
                    )
                    VALUES(?)
                    """,
                    (user_id,),
                )

            # ------------------------------------------------
            # PERSONAL WORKSPACE
            #
            # db.py migration handles old owner_id schemas.
            # New accounts get their workspace here.
            # ------------------------------------------------

            workspace = db.execute(
                """
                SELECT id
                FROM workspaces
                WHERE owner_user_id=?
                  AND workspace_type='personal'
                ORDER BY id
                LIMIT 1
                """,
                (user_id,),
            ).fetchone()

            if workspace is None:

                workspace_name = (
                    f"{name}'s Personal Space"
                )

                legacy_owner = db.execute(
                    """
                    SELECT 1
                    FROM pragma_table_info('workspaces')
                    WHERE name='owner_id'
                    LIMIT 1
                    """
                ).fetchone()

                if legacy_owner:

                    db.execute(
                        """
                        INSERT INTO workspaces(
                            name,
                            workspace_type,
                            owner_user_id,
                            owner_id
                        )
                        VALUES(
                            ?,
                            'personal',
                            ?,
                            ?
                        )
                        """,
                        (
                            workspace_name,
                            user_id,
                            user_id,
                        ),
                    )

                else:

                    db.execute(
                        """
                        INSERT INTO workspaces(
                            name,
                            workspace_type,
                            owner_user_id
                        )
                        VALUES(
                            ?,
                            'personal',
                            ?
                        )
                        """,
                        (
                            workspace_name,
                            user_id,
                        ),
                    )

                workspace_id = db.execute(
                    """
                    SELECT last_insert_rowid()
                    """
                ).fetchone()[0]

            else:
                workspace_id = workspace["id"]

            # ------------------------------------------------
            # OWNER MEMBERSHIP
            # ------------------------------------------------

            db.execute(
                """
                INSERT OR IGNORE INTO workspace_members(
                    workspace_id,
                    user_id,
                    role
                )
                VALUES(
                    ?,
                    ?,
                    'owner'
                )
                """,
                (
                    workspace_id,
                    user_id,
                ),
            )

            db.commit()

            session.clear()

            session["user_id"] = user_id
            session["user_name"] = name

            flash(
                "Your NEXUS profile is ready.",
                "success",
            )

            return redirect(
                url_for("main.dashboard")
            )

        except Exception:
            db.rollback()

            flash(
                "Unable to create the account. Please try again.",
                "error",
            )

    return render_template(
        "auth.html",
        mode="register",
    )


@main.route(
    "/login",
    methods=["GET", "POST"],
)
def login():

    if "user_id" in session:
        return redirect(
            url_for("main.dashboard")
        )

    if request.method == "POST":

        email = request.form.get(
            "email",
            "",
        ).strip().lower()

        password = request.form.get(
            "password",
            "",
        )

        user = get_db().execute(
            """
            SELECT *
            FROM users
            WHERE email=?
            """,
            (email,),
        ).fetchone()

        if user and check_password_hash(
            user["password_hash"],
            password,
        ):

            session.clear()

            session["user_id"] = user["id"]
            session["user_name"] = user["name"]

            return redirect(
                url_for("main.dashboard")
            )

        flash(
            "Invalid email or password.",
            "error",
        )

    return render_template(
        "auth.html",
        mode="login",
    )


