def validate_email_address(value):
    value = (value or "").strip().lower()

    pattern = (
        r"^[^@\s]+@[^@\s]+\.[^@\s]+$"
    )

    return bool(
        re.match(pattern, value)
    )


def validate_phone_number(value):
    """
    Basic E.164 validation.

    Example:
        +919876543210
    """

    value = (value or "").strip()

    return bool(
        re.fullmatch(
            r"\+[1-9]\d{7,14}",
            value,
        )
    )


def send_email_via_resend(
    recipient,
    subject,
    message_body,
):
    """
    Send an email using the Resend Python SDK.

    Required environment variables:
        RESEND_API_KEY
        EMAIL_FROM
    """

    api_key = os.getenv(
        "RESEND_API_KEY",
        "",
    ).strip()

    email_from = os.getenv(
        "EMAIL_FROM",
        "",
    ).strip()

    if not api_key:
        raise RuntimeError(
            "RESEND_API_KEY is not configured."
        )

    if not email_from:
        raise RuntimeError(
            "EMAIL_FROM is not configured."
        )

    import resend

    resend.api_key = api_key

    safe_body = escape(
        message_body
    ).replace(
        "\n",
        "<br>",
    )

    params = {
        "from": email_from,
        "to": [recipient],
        "subject": subject,
        "html": (
            "<div style="
            "\"font-family:Arial,sans-serif;"
            "line-height:1.6;"
            "white-space:normal;\">"
            f"{safe_body}"
            "</div>"
        ),
    }

    response = resend.Emails.send(
        params
    )

    provider_id = None

    if isinstance(response, dict):
        provider_id = (
            response.get("id")
            or response.get("data", {}).get("id")
            if isinstance(
                response.get("data"),
                dict,
            )
            else response.get("id")
        )

    else:
        provider_id = getattr(
            response,
            "id",
            None,
        )

    return provider_id


def send_sms_via_twilio(
    recipient,
    message_body,
):
    """
    Send an SMS using the Twilio Python SDK.

    Supported configuration:

    Option A:
        TWILIO_ACCOUNT_SID
        TWILIO_AUTH_TOKEN
        TWILIO_PHONE_NUMBER

    Option B:
        TWILIO_ACCOUNT_SID
        TWILIO_API_KEY
        TWILIO_API_SECRET
        TWILIO_PHONE_NUMBER
    """

    account_sid = os.getenv(
        "TWILIO_ACCOUNT_SID",
        "",
    ).strip()

    auth_token = os.getenv(
        "TWILIO_AUTH_TOKEN",
        "",
    ).strip()

    api_key = os.getenv(
        "TWILIO_API_KEY",
        "",
    ).strip()

    api_secret = os.getenv(
        "TWILIO_API_SECRET",
        "",
    ).strip()

    from_number = os.getenv(
        "TWILIO_PHONE_NUMBER",
        "",
    ).strip()

    if not account_sid:
        raise RuntimeError(
            "TWILIO_ACCOUNT_SID is not configured."
        )

    if not from_number:
        raise RuntimeError(
            "TWILIO_PHONE_NUMBER is not configured."
        )

    if not auth_token and not (
        api_key and api_secret
    ):
        raise RuntimeError(
            "Configure TWILIO_AUTH_TOKEN or "
            "TWILIO_API_KEY and TWILIO_API_SECRET."
        )

    from twilio.rest import Client

    if api_key and api_secret:
        client = Client(
            api_key,
            api_secret,
            account_sid,
        )
    else:
        client = Client(
            account_sid,
            auth_token,
        )

    message = client.messages.create(
        body=message_body,
        from_=from_number,
        to=recipient,
    )

    return getattr(
        message,
        "sid",
        None,
    )


