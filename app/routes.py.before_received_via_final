@main.post("/api/voice/confirm")
@login_required
def api_voice_confirm():

    data = (
        request.get_json(silent=True)
        or {}
    )

    voice_command_id = data.get(
        "voice_command_id"
    )

    if not voice_command_id:

        return jsonify({
            "success": False,
            "message": (
                "Voice command ID is required."
            ),
        }), 400

    db = get_db()

    command = db.execute(
        """
        SELECT *
        FROM voice_commands
        WHERE id=?
          AND user_id=?
        """,
        (
            voice_command_id,
            session["user_id"],
        ),
    ).fetchone()

    if not command:

        return jsonify({
            "success": False,
            "message": (
                "Voice command was not found."
            ),
        }), 404

    if command["status"] == "confirmed":

        return jsonify({
            "success": False,
            "message": (
                "This voice command has "
                "already been confirmed."
            ),
        }), 409

    if command["status"] == "rejected":

        return jsonify({
            "success": False,
            "message": (
                "This voice command has "
                "already been rejected."
            ),
        }), 409

    if command["parsed_kind"] not in (
        "income",
        "expense",
    ):

        return jsonify({
            "success": False,
            "message": (
                "Invalid transaction type."
            ),
        }), 400

    if command["parsed_category"] not in CATEGORIES:

        return jsonify({
            "success": False,
            "message": (
                "Invalid transaction category."
            ),
        }), 400

    if command["parsed_payment_method"] not in PAYMENTS:

        return jsonify({
            "success": False,
            "message": (
                "Invalid payment method."
            ),
        }), 400

    try:

        cursor = db.execute(
            """
            INSERT INTO transactions(
                user_id,
                kind,
                amount,
                category,
                payment_method,
                transaction_date,
                note,
                source,
                source_reference
            )
            VALUES(
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?
            )
            """,
            (
                session["user_id"],
                command["parsed_kind"],
                command["parsed_amount"],
                command["parsed_category"],
                command["parsed_payment_method"],
                command["parsed_date"],
                command["parsed_note"] or "",
                "voice",
                str(voice_command_id),
            ),
        )

        transaction_id = cursor.lastrowid

        db.execute(
            """
            UPDATE voice_commands

            SET
                status='confirmed',
                transaction_id=?

            WHERE id=?
              AND user_id=?
            """,
            (
                transaction_id,
                voice_command_id,
                session["user_id"],
            ),
        )

        db.commit()

        return jsonify({
            "success": True,
            "message": (
                "Voice transaction "
                "added successfully."
            ),
            "transaction_id": transaction_id,
        })

    except Exception as exc:

        db.rollback()

        return jsonify({
            "success": False,
            "message": (
                f"Unable to save transaction: {exc}"
            ),
        }), 500


