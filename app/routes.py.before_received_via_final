def parse_voice_transaction(text):
    """
    Parse natural-language voice transaction commands.

    Supports:
        - numeric amounts:
            500000
            5,00,000
            â‚¹500000
            Rs 500000
        - Indian units:
            thousand
            lakh / lakhs
            crore / crores
        - word numbers:
            five lakh
            twenty five thousand
            one crore twenty five lakh
        - category detection
        - payment method detection
        - today / yesterday
    """

    original = (text or "").strip()
    lower = original.lower()

    if not original:
        return {
            "success": False,
            "message": "I didn't hear a transaction.",
        }

    # --------------------------------------------------------
    # 1. TRANSACTION TYPE
    # --------------------------------------------------------

    income_words = [
        "income",
        "earned",
        "earning",
        "salary",
        "received",
        "receive",
        "credit",
        "credited",
        "deposit",
        "deposited",
        "got",
    ]

    expense_words = [
        "expense",
        "spent",
        "spend",
        "paid",
        "pay",
        "payment",
        "bought",
        "buy",
        "purchase",
        "purchased",
        "cost",
    ]

    income_score = sum(
        1
        for word in income_words
        if re.search(rf"\b{re.escape(word)}\b", lower)
    )

    expense_score = sum(
        1
        for word in expense_words
        if re.search(rf"\b{re.escape(word)}\b", lower)
    )

    if income_score > expense_score:
        kind = "income"
    else:
        kind = "expense"

    # --------------------------------------------------------
    # 2. WORD NUMBER CONVERSION
    # --------------------------------------------------------

    number_words = {
        "zero": 0,
        "one": 1,
        "two": 2,
        "three": 3,
        "four": 4,
        "five": 5,
        "six": 6,
        "seven": 7,
        "eight": 8,
        "nine": 9,
        "ten": 10,
        "eleven": 11,
        "twelve": 12,
        "thirteen": 13,
        "fourteen": 14,
        "fifteen": 15,
        "sixteen": 16,
        "seventeen": 17,
        "eighteen": 18,
        "nineteen": 19,
        "twenty": 20,
        "thirty": 30,
        "forty": 40,
        "fifty": 50,
        "sixty": 60,
        "seventy": 70,
        "eighty": 80,
        "ninety": 90,
    }

    def words_to_number(words):
        total = 0
        current = 0

        for word in words:
            if word in number_words:
                current += number_words[word]

            elif word == "hundred":
                current = max(current, 1) * 100

            elif word in ("thousand", "thousands"):
                total += current * 1000
                current = 0

            elif word in ("lakh", "lakhs"):
                total += current * 100000
                current = 0

            elif word in ("crore", "crores"):
                total += current * 10000000
                current = 0

        return total + current

    # --------------------------------------------------------
    # 3. SPOKEN NUMBER DETECTION
    # --------------------------------------------------------

    word_pattern = (
        r"zero|one|two|three|four|five|six|seven|eight|nine|ten|"
        r"eleven|twelve|thirteen|fourteen|fifteen|sixteen|"
        r"seventeen|eighteen|nineteen|twenty|thirty|forty|"
        r"fifty|sixty|seventy|eighty|ninety|hundred|"
        r"thousand|thousands|lakh|lakhs|crore|crores"
    )

    spoken_pattern = (
        rf"\b(?:{word_pattern})"
        rf"(?:\s+(?:{word_pattern})){0,10}\b"
    )

    spoken_matches = re.findall(
        spoken_pattern,
        lower,
    )

    amount = None

    # Prefer expressions containing Indian units.
    for match in spoken_matches:
        words = match.split()

        if any(
            word in (
                "thousand",
                "thousands",
                "lakh",
                "lakhs",
                "crore",
                "crores",
            )
            for word in words
        ):
            parsed = words_to_number(words)

            if parsed > 0:
                amount = parsed
                break

    # --------------------------------------------------------
    # 4. PLAIN SPOKEN NUMBER
    # --------------------------------------------------------

    if amount is None and spoken_matches:

        money_context = any(
            word in lower
            for word in [
                "rupee",
                "rupees",
                "rs",
                "inr",
                "â‚¹",
                "spent",
                "spend",
                "paid",
                "payment",
                "cost",
                "income",
                "earned",
                "salary",
                "received",
            ]
        )

        if money_context:
            for match in spoken_matches:
                parsed = words_to_number(
                    match.split()
                )

                if parsed > 0:
                    amount = parsed
                    break

    # --------------------------------------------------------
    # 5. NUMERIC AMOUNT FALLBACK
    # --------------------------------------------------------

    if amount is None:

        numeric_patterns = [
            r"(?:â‚¹|rs\.?|inr)\s*([\d,]+(?:\.\d+)?)",
            r"\b([\d]{1,3}(?:,[\d]{2,3})+)\b",
            r"\b(\d+(?:\.\d+)?)\b",
        ]

        for pattern in numeric_patterns:

            match = re.search(
                pattern,
                lower,
            )

            if match:

                try:
                    amount = float(
                        match.group(1).replace(",", "")
                    )
                    break

                except ValueError:
                    pass

    # --------------------------------------------------------
    # 6. VALIDATE AMOUNT
    # --------------------------------------------------------

    if amount is None or amount <= 0:
        return {
            "success": False,
            "message": (
                "I couldn't identify the amount. "
                "Try saying something like "
                "'five lakh for education in cash'."
            ),
            "transcript": original,
        }

    amount = round(float(amount), 2)

    # --------------------------------------------------------
    # 7. CATEGORY DETECTION
    # --------------------------------------------------------

    category_keywords = {
        "Food": [
            "food",
            "dinner",
            "lunch",
            "breakfast",
            "restaurant",
            "meal",
            "pizza",
            "burger",
            "coffee",
            "groceries",
            "grocery",
            "swiggy",
            "zomato",
            "cafe",
            "snack",
        ],

        "Transport": [
            "transport",
            "petrol",
            "diesel",
            "fuel",
            "uber",
            "ola",
            "metro",
            "bus",
            "train",
            "taxi",
            "cab",
            "rickshaw",
            "auto",
        ],

        "Bills": [
            "bill",
            "bills",
            "electricity",
            "water",
            "internet",
            "wifi",
            "recharge",
            "mobile",
            "phone bill",
            "rent",
        ],

        "Shopping": [
            "shopping",
            "clothes",
            "clothing",
            "shirt",
            "shoes",
            "dress",
            "amazon",
            "flipkart",
        ],

        "Entertainment": [
            "movie",
            "movies",
            "cinema",
            "netflix",
            "spotify",
            "game",
            "gaming",
            "entertainment",
            "concert",
        ],

        "Health": [
            "medicine",
            "medicines",
            "doctor",
            "hospital",
            "pharmacy",
            "health",
            "medical",
            "gym",
        ],

        "Education": [
            "education",
            "college",
            "school",
            "course",
            "courses",
            "book",
            "books",
            "tuition",
            "fee",
            "fees",
            "exam",
            "study",
            "udemy",
        ],

        "Travel": [
            "travel",
            "trip",
            "hotel",
            "flight",
            "vacation",
            "tour",
        ],
    }

    category = "Other"

    for candidate_category, keywords in category_keywords.items():

        if any(
            keyword in lower
            for keyword in keywords
        ):
            category = candidate_category
            break

    # --------------------------------------------------------
    # 8. PAYMENT METHOD
    # --------------------------------------------------------

    if any(
        word in lower
        for word in [
            "upi",
            "gpay",
            "google pay",
            "phonepe",
            "paytm",
        ]
    ):
        payment_method = "UPI"

    elif any(
        word in lower
        for word in [
            "credit card",
            "creditcard",
        ]
    ):
        payment_method = "Credit Card"

    elif any(
        word in lower
        for word in [
            "debit card",
            "debitcard",
        ]
    ):
        payment_method = "Debit Card"

    elif any(
        word in lower
        for word in [
            "bank transfer",
            "neft",
            "imps",
            "rtgs",
            "bank",
        ]
    ):
        payment_method = "Bank Transfer"

    elif "cash" in lower:
        payment_method = "Cash"

    else:
        payment_method = "Other"

    # --------------------------------------------------------
    # 9. DATE
    # --------------------------------------------------------

    transaction_date = date.today()

    if "yesterday" in lower:
        transaction_date = (
            date.today()
            - timedelta(days=1)
        )

    # --------------------------------------------------------
    # 10. RESULT
    # --------------------------------------------------------

    return {
        "success": True,
        "kind": kind,
        "amount": amount,
        "category": category,
        "payment_method": payment_method,
        "transaction_date": transaction_date.isoformat(),
        "date": transaction_date.isoformat(),
        "note": original,
        "transcript": original,
        "message": (
            f"Detected â‚¹{amount:,.0f} {kind} "
            f"for {category} via {payment_method}."
        ),
    }


