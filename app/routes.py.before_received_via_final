            "id": row["id"],
            "channel": row["channel"],
            "recipient": row["recipient"],
            "title": row["title"],
            "message_body": row["message_body"],
            "provider_message_id": (
                row["provider_message_id"]
            ),
            "status": row["status"],
            "error_message": row["error_message"],
            "created_at": row["created_at"],
            "sent_at": row["sent_at"],
        })

    for row in sms_rows:
        records.append({
            "id": row["id"],
            "channel": row["channel"],
            "recipient": row["recipient"],
            "title": row["title"],
